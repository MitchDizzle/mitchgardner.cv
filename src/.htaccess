# mitchgardner.cv on Apache shared hosting (same host as mtch.tech and lvcafetogo.com).

ErrorDocument 404 /404.html
Options -Indexes

# Turn these on once https://mitchgardner.cv loads with a valid certificate.
# Before that, the redirect would send every visitor to a broken page.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# </IfModule>

# CSS links carry a content hash (the `bust` filter), so they can be cached hard.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType application/pdf "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
