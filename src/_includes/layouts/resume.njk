<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {#- Self-contained on purpose: CSS is inline so scripts/resume-pdf.js can print this page straight from disk. -#}
  {#- Same title for every version: Chrome copies it into the PDF, and an employer should never see "Support" or "Tailored". -#}
  <title>{{ resume.name }}: Resume</title>
  <meta name="description" content="Resume of {{ resume.name }}, {{ variant.title }}.">
  {% if variant.slug %}<meta name="robots" content="noindex">{% else %}<link rel="canonical" href="{{ site.url }}/resume/">{% endif %}
  <meta name="color-scheme" content="light dark">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,700&display=block">
  <style>
{% include "css/resume.css" %}
  </style>
  <script>
{% include "js/motion.js" %}
  </script>
</head>
<body>
  <nav class="bar" aria-label="Resume">
    <a href="/">{{ site.shortName }}</a>
    {% if variant.slug %}<span>This is the {{ variant.label | lower }} version. <a href="/resume/">Main resume</a></span>{% endif %}
    <span class="bar__actions">
      {% include "partials/motion-toggle.njk" %}
      <a href="/{{ resume.variants[0].file }}.pdf">Download PDF</a>
      <button type="button" onclick="window.print()">Print</button>
    </span>
  </nav>
  {{ content | safe }}
</body>
</html>
